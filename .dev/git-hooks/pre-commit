#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

REPOSITORY_ROOT_PATH="$(git rev-parse --show-toplevel 2> /dev/null || true)"
if [[ "" = "${REPOSITORY_ROOT_PATH}" ]]; then
    exit 0
fi

cd "${REPOSITORY_ROOT_PATH}"

. "${REPOSITORY_ROOT_PATH}/.dev/utility.sh"

section "pre commit start"

cleanup() {
    EXIT_CODE=$?

    if [[ 0 = ${EXIT_CODE} ]]; then
        success "pre commit end"
    else
        error "pre commit end failed"
    fi

    exit ${EXIT_CODE}
}
trap cleanup EXIT

STAGED_PATH_LIST="$(git --no-pager diff --cached --name-only | awk 'NF')"

if [[ "" = "${STAGED_PATH_LIST}" ]]; then
    warning "no files to commit"

    exit 0
fi

FORBIDDEN_PATH_LIST="$(printf '%s\n' "${STAGED_PATH_LIST}" | awk '
    /^\.dev-data\// { print; next }
    $0 == ".dev/docker/.env.local" { print; next }
')"

if [[ "" != "${FORBIDDEN_PATH_LIST}" ]]; then
    println "${FORBIDDEN_PATH_LIST}"

    fail "forbidden artifacts staged"
fi

print_command "staged files start"
println "${STAGED_PATH_LIST}"
print_command "staged files end"

println ""

bash "${REPOSITORY_ROOT_PATH}/.dev/validate/all.sh" --staged
